# Local CoL download helper (personal utility, not part of the app)
col/download_CoL.py

# Local caches (Catalogue of Life, taxonomy databases)
col/*.zip
col/taxonomy.db
col/build.log
col/build2.log
col/build.err.log

# Image catalog database (generated locally on first run)
output/catalog.db

# Local analysis results (copied images + descriptions)
output/plante/
output/pasari/
output/animale/
output/ciuperci/
output/altele/
output/*_description.txt

# Books/dictionaries as PDF (copyright, too large for GitHub)
name_sources/*.pdf

# Working Excel files with names (generated locally / personal)
tools/denumiri_*.xlsx
denumiri_*.xlsx

# Temporary working scripts
_*.py
_verify_*.py
_smoke_*.py

# Local dev helper scripts (catalog reconciliation, one-off inspectors).
# Kept locally for the maintainer, not part of the app or its distribution.
/tools/dev_tools/

# Local development utilities: versioned on purpose — they are the build
# process (app_restart) and the regression net (test_*.py, i18n_lint.py).
# Only the throwaway probes stay out.
/tools/local_dev/_*
/tools/local_dev/*.bak

# Superseded prompt copies: kept locally for comparison, not part of the app
prompts/bkup/

# Source-only distribution: local data must never be committed
# (input/, output/, name_sources/ ignore their own content
# via their nested .gitignore files, which ARE tracked)
/output/*
!/output/.gitignore
/logs/
# (name_sources/ ignores its own content via its nested .gitignore)
